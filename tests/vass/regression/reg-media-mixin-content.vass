$mediaMinWidth: 480px
@function translate-media-condition($c)
  $condMap: ("screen": "only screen" , ">minWidth" : "(min-width: #{$mediaMinWidth + 1})" )
  @return map-get($condMap, $c)
@mixin media($args...)
  $query: ""
  @each $arg in $args
    $op: ""
    @if ($query != "" )
      $op: " and "
    $query: $query + $op + translate-media-condition($arg)
  @media #{$query}
    @content
.header
  @include media("screen", ">minWidth" )
    display: none